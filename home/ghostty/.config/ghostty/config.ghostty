# ============================================
# GHOSTTY
# ============================================

# Appearance: always dark
theme = Catppuccin Mocha
window-theme = dark
macos-titlebar-style = native

# Font
font-family = JetBrains Mono
font-size = 13

# Clean layout
window-padding-x = 8
window-padding-y = 6

# Slightly translucent window background
background-opacity = 0.95

# macOS keyboard behavior (the macos-* options are ignored on Linux)
macos-option-as-alt = left

# Cmd+K clears the screen: sends Ctrl+B Ctrl+L, tmux's clear binding (plain
# Ctrl+L moves between panes). Outside tmux it still clears the shell.
keybind = cmd+k=text:\x02\x0c

# Shell integration
shell-integration = detect
# Only matters when you `ssh` from Ghostty to a machine that does not know the
# xterm-ghostty terminal type (e.g. Ubuntu Server, where tmux/nvim/clear would fail
# with "unknown terminal type"): ssh-terminfo copies it over on first connect,
# ssh-env falls back to TERM=xterm-256color if that fails. Harmless elsewhere.
shell-integration-features = ssh-terminfo,ssh-env

# Performance and usability
scrollback-limit = 10000000
mouse-hide-while-typing = true

# Safety: don't automatically copy selections
copy-on-select = false

# Desktop notifications from programs (Claude Code, Codex); click focuses the tab
desktop-notifications = true
