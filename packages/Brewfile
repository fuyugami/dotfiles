# macOS only: Homebrew formulae and apps. (Linux uses apt/dnf plus official
# release binaries: packages/apt.txt, dnf.txt and `install.sh tools`.)
# Not here on purpose: toolchains with an official installer are set up by
# their own steps — Go (go.dev tarball), Node (nvm), Python (Miniforge, uv),
# Claude Code (native installer). Ghostty is optional: `install.sh ghostty`.

# Shell & terminal
brew "tmux"
brew "stow"
brew "fzf"
brew "zoxide"
brew "fastfetch"
brew "powerlevel10k"

# Editor (Neovim + what its config expects on PATH)
brew "neovim"
brew "tree-sitter-cli"
brew "ripgrep"
brew "fd"
brew "lua-language-server"
brew "stylua"
brew "texlab" # LaTeX language server; TeX Live itself: install.sh latex

# Code quality
brew "pre-commit"
brew "shellcheck"
brew "golangci-lint"
brew "lazygit"

# Containers & infra
brew "kubernetes-cli"
brew "mkcert"

# Docs & network
brew "pandoc"
brew "wget"
brew "socat"
brew "telnet"

# Docker via Colima (configured by `install.sh docker`)
brew "colima", restart_service: :changed
brew "docker"
brew "docker-buildx"
brew "docker-compose"

# Apps the setup relies on (Ghostty is optional: `install.sh ghostty`)
cask "codex"
cask "skim" # PDF viewer with SyncTeX for VimTeX
